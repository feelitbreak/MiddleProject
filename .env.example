# Copy to .env before `docker compose up`. The real values live in the repository secrets on
# GitHub; nothing here is a credential.
#
# Each service gets its own key, so the UI container never holds one for a service it does not
# talk to. Rotating is an edit here plus a restart -- no image rebuild, because nginx reads these
# at container start rather than at build time.
PROCESSOR_API_KEY=
GRAPHQL_API_KEY=
NOTIFICATION_API_KEY=
