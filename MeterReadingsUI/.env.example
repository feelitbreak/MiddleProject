# Copy to .env and adjust. Development configuration. Vite inlines VITE_-prefixed values at build time, so these are the
# paths the browser calls; the two *_PROXY_TARGET values are read by vite.config.ts only.

# Same-origin paths: the dev proxy and nginx both forward them, so no CORS and no host in the bundle.
VITE_GRAPHQL_URL=/graphql
VITE_HUB_URL=/hubs/readings

# Where the dev server forwards those paths.
GRAPHQL_PROXY_TARGET=http://localhost:8086
HUB_PROXY_TARGET=http://localhost:8088

# To point a build at absolute back-end addresses instead of the proxy, set these to full URLs:
#   VITE_GRAPHQL_URL=https://gateway.example.com/graphql
#   VITE_HUB_URL=https://notifications.example.com/hubs/readings
# Both services must then allow this origin in their Cors:AllowedOrigins.
