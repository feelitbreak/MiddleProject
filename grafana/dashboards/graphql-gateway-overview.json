{
  "uid": "graphql-gateway-overview",
  "title": "GraphQL Gateway Service - Overview",
  "tags": [
    "graphql-gateway",
    "graphql",
    "postgres"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "GraphQL errors by code",
      "description": "The only view of GraphQL failures: every response is HTTP 200, so the 5xx rate below stays flat even while every query fails. BAD_USER_INPUT is callers getting it wrong; INTERNAL_SERVER_ERROR is this service getting it wrong. Covers resolver failures and validation rejections; cost-limit rejections are not counted, so watch request rate for those.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(graphql_gateway_graphql_errors_total[5m])) by (error_code)",
          "legendFormat": "{{error_code}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request rate",
      "description": "GraphQL operations per second. One route, so this is the whole traffic picture.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"graphql-gateway-service\"}[5m])) by (http_route)",
          "legendFormat": "{{http_route}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request duration (p95)",
      "description": "A latest-values lookup and a 90-day aggregation share this histogram, so a rising p95 usually means the mix shifted toward aggregation rather than that anything slowed down.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket{job=\"graphql-gateway-service\"}[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Request duration (p50)",
      "description": "The typical request, for comparison against p95.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(http_server_request_duration_seconds_bucket{job=\"graphql-gateway-service\"}[5m])) by (le))",
          "legendFormat": "p50"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP 5xx rate",
      "description": "Transport-level failures only \u2014 a malformed body, or the host falling over. A failing resolver does NOT appear here; see GraphQL errors by code.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"graphql-gateway-service\",http_response_status_code=~\"5..\"}[5m]))",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Requests in flight",
      "description": "Concurrent requests. A sustained climb with flat throughput means requests are queueing on the database.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(http_server_active_requests{job=\"graphql-gateway-service\"})",
          "legendFormat": "in flight"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "GC heap size",
      "description": "Managed heap after the last collection.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(dotnet_gc_last_collection_heap_size_bytes{job=\"graphql-gateway-service\"})",
          "legendFormat": "heap"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Thread pool queue length",
      "description": "Work items waiting for a thread. On a database-bound gateway a saturated connection pool shows up here before it shows up as latency.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(dotnet_thread_pool_queue_length{job=\"graphql-gateway-service\"})",
          "legendFormat": "queued"
        }
      ]
    }
  ]
}
