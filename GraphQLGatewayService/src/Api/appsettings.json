{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowLocalhost": false,
    "AllowedOrigins": []
  },
  "AllowedHosts": "*",
  "ApiKey": {
    "Key": ""
  },
  "Cache": {
    "AggregateSeconds": 20,
    "CatalogueSeconds": 60
  },
  "RateLimiting": {
    "PermitLimit": 32,
    "QueueLimit": 64
  },
  "Database": {
    "ConnectionString": "",
    "CommandTimeoutSeconds": 30,
    "MaxRetryCount": 5,
    "MaxRetryDelaySeconds": 10
  }
}
