<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Domain\DataProcessorService.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The rules CI enforces through dotnet-sonarscanner, running in the local build too. Without
      this the SonarQube rules are invisible to `dotnet build` and only an IDE plugin reports them,
      so a violation is not found until the pipeline fails.
    -->
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.34.0.3385">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
